rules_version = '2';

// All reads and writes go through the Next.js API (Firebase Admin), which
// verifies the user's ID token and enforces demo rules server-side.
// The browser never talks to Firestore directly, so everything is denied here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
