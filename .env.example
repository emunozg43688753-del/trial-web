# ─────────────────────────────────────────────────────────────
# TRIAL — environment variables
# Copy to .env.local for local development. Never commit real values.
# Without LLM_API_KEY the app runs in DEMO MODE (simulated intelligence).
# ─────────────────────────────────────────────────────────────

# LLM (server-only — never prefix with NEXT_PUBLIC_)
LLM_API_KEY=
LLM_MODEL=

# Optional: "openai" (any OpenAI-compatible API) | "anthropic".
# If omitted, it is inferred from the key format (sk-ant-… → anthropic).
LLM_PROVIDER=
# Optional: custom OpenAI-compatible endpoint (Groq, OpenRouter, Together, AI Gateway…)
LLM_BASE_URL=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.4

# Public URL used for SEO (canonical, sitemap, Open Graph)
NEXT_PUBLIC_APP_URL=

# Contact form delivery (optional — each channel activates when set)
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Firebase Auth (login / register) ─────────────────────────
# Web app config (public): Firebase console → Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account (server only): Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Growth & follow-up ───────────────────────────────────────
# Email sequence via Resend (RESEND_API_KEY above). Verified sender domain:
EMAIL_FROM="TRIAL <hola@tudominio.com>"
# Protects /api/cron/follow-ups (Vercel sends it automatically) and signs unsubscribe links
CRON_SECRET=
# "Talk to sales" destination: booking page (Calendly/Cal.com) and/or WhatsApp number with country code
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
